# 파일 역할: AWS 개발·통합(dev) 환경의 서버 shared/api.env 작성용 예시.
# develop의 검증 이미지를 사용합니다. DB는 별도 준비하고 비밀번호는 서버에서 직접 입력합니다.
APP_ENV=dev
API_HOST_PORT=18000
DB_HOST=
DB_PORT=5432
DB_NAME=coach_dev
DB_USER=coach_dev_app
DB_PASSWORD=

# DB_HOST에 RDS endpoint 지정. 공개 CA bundle은 공식 배포처에서 내려받고 갱신합니다.
RDS_CA_BUNDLE_HOST_PATH=/opt/presentation/shared-certs/global-bundle.pem

# S3 연동 예약값: API/AI 업로드 코드 연결 전에는 동작하지 않습니다.
# AWS 장기 키는 넣지 않고 컨테이너용 역할/자격 공급 방식은 S3 구현 시 확정합니다.
AWS_REGION=
S3_BUCKET=
S3_PREFIX=dev/
