# 파일 역할: EC2의 /opt/presentation/<dev|demo>/shared/api.env 작성용 예시.
# 실제 파일은 Git 제외·chmod 600. dev/demo의 DB·자격정보는 분리합니다.
APP_ENV=dev
API_HOST_PORT=18000
# 같은 EC2의 demo 환경을 함께 켜면 API_HOST_PORT=18001 등으로 분리합니다.
# DB는 별도 준비하며 이 Compose는 생성하지 않습니다. localhost는 API 컨테이너 자신입니다.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# DB_HOST에 RDS endpoint 지정. 공개 CA bundle은 공식 배포처에서 내려받고 갱신합니다.
RDS_CA_BUNDLE_HOST_PATH=/opt/presentation/shared-certs/global-bundle.pem

# S3 연동 예약값: API/AI 업로드 코드 연결 전에는 동작하지 않습니다.
# AWS 장기 키는 넣지 않고 컨테이너용 역할/자격 공급 방식은 S3 구현 시 확정합니다.
AWS_REGION=
S3_BUCKET=
S3_PREFIX=dev/
